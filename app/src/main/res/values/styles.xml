<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="QuickIDDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/QuickIDDialogPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/QuickIDDialogNeutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/QuickIDDialogNeutral</item>
    </style>

    <style name="QuickIDDialogPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/dialog_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="QuickIDDialogNeutral" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/dialog_neutral</item>
        <item name="android:textColor">#1E2952</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
